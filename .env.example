# Discord Webhook URL (from Discord Channel -> Integrations -> Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Comma-separated list of X (Twitter) handles to track
ACCOUNTS=sunnewstamil,News18TamilNadu,polimernews

# Optional: GitHub API settings for persisting posted_tweets.json on Render
# Create a fine-grained Personal Access Token with "Contents: Read and write" access to your repo
GITHUB_TOKEN=ghp_your_github_personal_access_token_here
GITHUB_REPO=cold-logic5/News-Flash-Bot
GITHUB_BRANCH=master

# Optional: Web server settings (Render sets PORT automatically)
PORT=8080

# Optional: Secret token to protect the /run endpoint from unauthorized triggers
# If set, cron-job.org should call: https://your-service.onrender.com/run?token=your_secret_here
CRON_SECRET=your_optional_secret_token_here
